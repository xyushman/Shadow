# ========================================
# Nyx - Environment Configuration
# ========================================
# Copy this file to .env and fill in your values.
# This file stores sensitive credentials. Do not commit .env to version control.

# ----- API Keys -----
# Deepgram API key for Speech-to-Text
# Get your key from: https://console.deepgram.com/
DEEPGRAM_API_KEY="your_deepgram_api_key_here"

# ----- Logging -----
# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ----- Development Mode -----
# Controls debugging features across Python and JavaScript
# Set to true to enable verbose console logging and dev shortcuts
DEV_MODE=false

# ----- AI Behaviour -----
TRACK_CANDIDATE_RESPONSES=true
INCLUDE_CONVERSATION_HISTORY=true
MAX_CONVERSATION_HISTORY=24
GENERATE_FULL_ANSWERS=true
PERSONALIZE_ANSWERS=true
COMPACT_ANSWER_PROMPT=true

# ----- Latency budgets -----
# Vision fallback chain must finish before the UI's 45s client timeout.
VISION_TIMEOUT_S=22
VISION_TOTAL_TIMEOUT_S=35
VISION_MAX_TOKENS=4096
VISION_COMPACT_PROMPT=true
LLM_TIMEOUT_S=25
LLM_TOTAL_TIMEOUT_S=32
# Keep prompts small when conversation history grows.
MAX_HISTORY_CHARS=1200
MAX_VISION_HISTORY_CHARS=350
MAX_FALLBACK_MODELS_PER_PROVIDER=2

# ----- Stealth / Proctoring -----
# Stealth mode: "invisible" (default) = hide-by-default — window is visible
# during setup, auto-hides when the interview starts (absent from screen
# shares entirely: no black rectangle, no content). Alt+Z peeks it back.
# "blackout" = old WDA_EXCLUDEFROMCAPTURE approach (window appears as a
# BLACK RECTANGLE in screen share — avoid in proctored environments).
STEALTH_MODE=invisible
# Seconds an Alt+Z peek stays on screen before auto-hiding (0 = never
# auto-hide). While peeked the window IS visible in a screen share.
STEALTH_PEEK_SECONDS=10
# Seconds between sweeps for screen-sharing indicator windows.
# Higher = less CPU, slower to hide a newly appeared indicator. Minimum 0.2
SCREEN_SHARE_SCAN_INTERVAL_S=1.0

# ----- Scroll Speed (Alt+Up/Down) -----
# Pixels per scroll tick — higher = faster scroll
# Examples: 100 = slow, 200 = medium (default), 400 = fast
SCROLL_SPEED_PX=200
# Milliseconds between scroll ticks while key is held — lower = smoother/faster
# Examples: 30 = fast, 50 = default, 80 = slow
SCROLL_INTERVAL_MS=50
